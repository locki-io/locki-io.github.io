# locki-io — .env.config template  (CONFIG class: never rotates; agent may write)
# Copy to .env.config at the repo root. The loader is `set -a && source .env.config && set +a`.
# This repo is PUBLIC: no secrets belong here, so no `<forseti - ok>` placeholders exist —
# `grep -c 'forseti - ok' env-templates/*.example` legitimately returns 0.

PROJECT=locki-io
SITE_URL=https://www.locki.io

# Google Analytics measurement id — public by nature (it ships inside the served HTML).
# Operator decision 2026-08-29: kept ("let the world see us").
# Today the id is literal in index.html. Injecting it via %VITE_GA_MEASUREMENT_ID%
# is an open item (Arc42 §11): do NOT change index.html until CI provides the var.
VITE_GA_MEASUREMENT_ID=G-RHE5V722CZ
